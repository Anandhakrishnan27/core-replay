# Copy to .env (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
# Discovery model. Empty = claude-opus-5-5 (the default). Set a model id to override.
# Must be a current model that accepts `output_config.effort` (Claude 4.6+ family).
CUA_MODEL=

# Mock bank login (synthetic). Read only by the session provider; never sent to the LLM.
MOCKBANK_USER=teller01
MOCKBANK_PASSWORD=change-me

# Salt for hashing PII in logs
CUA_REDACTION_SALT=change-me
# false = visible browser (needed for human handoff)
CUA_HEADLESS=false
