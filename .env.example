# Copy to .env (git-ignored). Never commit real values.
ANTHROPIC_API_KEY=
# A current Claude Sonnet model id, see https://docs.claude.com/en/docs/about-claude/models
CUA_MODEL=

# Mock bank login (synthetic). Read only by the session provider; never sent to the LLM.
MOCKBANK_USER=teller01
MOCKBANK_PASSWORD=change-me

# Salt for hashing PII in logs
CUA_REDACTION_SALT=change-me
# false = visible browser (needed for human handoff)
CUA_HEADLESS=false
